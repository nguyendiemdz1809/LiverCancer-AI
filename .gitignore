reports/pipeline_validation*/**/*.json
# per-patient Test tables (source of truth: outputs/final_test/)
reports/final_test/*.csv

# website (React + Vite): dependencies and build output are regenerated (npm install / npm run build)
web/node_modules/
web/dist/
web/.env
web/.env.*
