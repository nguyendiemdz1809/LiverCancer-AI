web/*.tsbuildinfo

# portable tools downloaded for deployment (cloudflared.exe)
tools/

# local copy of the locked Test set for manual website testing (dataset images; MRI CC BY-NC): never commit
TEST_3D_WEBSITE/
TEST_2D_WEBSITE/

